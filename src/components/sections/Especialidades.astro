---
import { ESPECIALIDADES } from '@utils/constants';

const iconMap: Record<string, string> = {
  gastroenterologia: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="32" height="32"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  urologia: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="32" height="32"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3" /></svg>`,
  orl: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="32" height="32"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" /></svg>`,
  otras: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="32" height="32"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>`,
};
---

<section class="py-20 bg-surface" id="especialidades" aria-labelledby="especialidades-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 id="especialidades-heading" class="text-3xl sm:text-4xl font-bold text-dark">
        Áreas de especialidad
      </h2>
      <p class="mt-4 text-neutral-600 max-w-2xl mx-auto">
        Contamos con insumos especializados para las principales especialidades médicas,
        con stock permanente y disponibilidad inmediata.
      </p>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" role="list">
      {ESPECIALIDADES.map(({ id, label, descripcion }) => (
        <li>
          <a
            href={`/catalogo?especialidad=${id}`}
            class="group flex flex-col gap-4 p-6 bg-white rounded-2xl border border-neutral-100 shadow-sm hover:shadow-md hover:border-primary transition-all duration-200 h-full"
          >
            <span
              class="flex items-center justify-center w-14 h-14 rounded-xl bg-primary-light text-primary group-hover:bg-primary group-hover:text-white transition-colors duration-200"
              aria-hidden="true"
              set:html={iconMap[id]}
            />
            <div class="flex flex-col gap-1 flex-1">
              <span class="font-semibold text-dark text-lg">{label}</span>
              <span class="text-neutral-600 text-sm leading-relaxed">{descripcion}</span>
            </div>
            <span class="text-primary text-sm font-medium group-hover:underline">
              Ver productos →
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
