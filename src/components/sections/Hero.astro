---
import Button from '@components/ui/Button.astro';
import { SITE, CONTACT } from '@utils/constants';
---

<section
  class="relative bg-dark overflow-hidden py-24 sm:py-32 lg:py-40"
  aria-labelledby="hero-title"
>
  <!-- Fondo decorativo -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute -top-40 -right-40 w-96 h-96 rounded-full bg-primary/10 blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 rounded-full bg-primary/5 blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 bg-primary/20 text-primary-light border border-primary/30 rounded-full px-4 py-1.5 text-sm font-medium mb-8">
      <span class="w-2 h-2 rounded-full bg-primary animate-pulse" aria-hidden="true"></span>
      {SITE.anos} años en el mercado médico
    </div>

    <h1
      id="hero-title"
      class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight text-white max-w-4xl mx-auto leading-tight"
    >
      {SITE.fraseEstrategica}
    </h1>

    <p class="mt-6 text-lg sm:text-xl text-neutral-300 max-w-2xl mx-auto leading-relaxed">
      Importación y comercialización de insumos médicos y descartables.
      Gastroenterología, Urología, ORL y más especialidades.
      <strong class="text-white font-semibold"> Mendoza, Argentina.</strong>
    </p>

    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
      <Button href="/catalogo" size="lg">
        Ver catálogo completo
      </Button>
      <Button
        href={CONTACT.whatsapp.principal}
        variant="outline"
        size="lg"
        external
        class="border-white/30 text-white hover:bg-white/10 hover:border-white/50"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12 0C5.373 0 0 5.373 0 12c0 2.124.557 4.117 1.532 5.845L.057 23.49a.5.5 0 0 0 .612.612l5.782-1.447A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.89 0-3.66-.5-5.19-1.374l-.37-.22-3.834.958.977-3.763-.242-.384A9.958 9.958 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
        Consultá por WhatsApp
      </Button>
    </div>

    <!-- Slogan footer -->
    <p class="mt-14 text-sm text-neutral-500 italic">
      "{SITE.fraseInstitucional}"
    </p>
  </div>
</section>
