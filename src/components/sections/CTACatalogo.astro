---
import Button from '@components/ui/Button.astro';
---

<section class="bg-dark py-20" aria-labelledby="cta-catalogo-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 id="cta-catalogo-heading" class="text-3xl sm:text-4xl font-bold text-white">
      Catálogo completo de insumos médicos
    </h2>
    <p class="mt-4 text-neutral-300 max-w-2xl mx-auto text-lg">
      Gastroenterología, Urología, ORL y más especialidades.
      Todo con stock real y disponibilidad inmediata.
    </p>
    <div class="mt-8">
      <Button href="/catalogo" size="lg" class="bg-primary hover:bg-primary-hover text-white border-0">
        Ver catálogo completo
      </Button>
    </div>
  </div>
</section>
