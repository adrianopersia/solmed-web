---
import Layout from '@layouts/Layout.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import Hero from '@components/sections/Hero.astro';
import TrustBar from '@components/sections/TrustBar.astro';
import Especialidades from '@components/sections/Especialidades.astro';
import PorQueElegirnos from '@components/sections/PorQueElegirnos.astro';
import CTACatalogo from '@components/sections/CTACatalogo.astro';
import CTADistribuidores from '@components/sections/CTADistribuidores.astro';
import ContactoRapido from '@components/sections/ContactoRapido.astro';
---

<Layout
  title="Inicio"
  description="SOLMED SA — Insumos médicos y descartables en Mendoza. Gastroenterología, Urología, ORL y más. Stock inmediato para que la solución no espere."
>
  <Header />

  <main id="main-content">
    <Hero />
    <TrustBar />
    <Especialidades />
    <PorQueElegirnos />
    <CTACatalogo />
    <CTADistribuidores />
    <ContactoRapido />
  </main>

  <Footer />
</Layout>
