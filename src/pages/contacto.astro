---
import Layout from '@layouts/Layout.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import { CONTACT } from '@utils/constants';
---

<Layout
  title="Contacto"
  description="Contactá a SOLMED SA en Mendoza. WhatsApp, email y formulario de contacto para consultas y presupuestos de insumos médicos."
>
  <Header />

  <main id="main-content">
    <!-- Hero -->
    <section class="bg-dark py-16 px-4 text-center">
      <div class="max-w-2xl mx-auto">
        <h1 class="text-4xl sm:text-5xl font-bold text-white">Contacto</h1>
        <p class="mt-4 text-neutral-300 text-lg">
          Respondemos consultas y presupuestos a la brevedad.
        </p>
      </div>
    </section>

    <!-- Contenido -->
    <section class="py-20 px-4 bg-surface">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <!-- Formulario -->
        <div>
          <h2 class="text-2xl font-bold text-dark mb-6">Envianos un mensaje</h2>
          <form
            id="form-contacto"
            class="bg-white rounded-2xl p-8 shadow-sm border border-neutral-100 flex flex-col gap-5"
            novalidate
          >
            <div class="flex flex-col gap-1.5">
              <label for="c-nombre" class="text-sm font-medium text-dark">Nombre completo *</label>
              <input id="c-nombre" name="nombre" type="text" required placeholder="Tu nombre"
                class="px-4 py-2.5 rounded-lg border border-neutral-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="flex flex-col gap-1.5">
                <label for="c-email" class="text-sm font-medium text-dark">Email</label>
                <input id="c-email" name="email" type="email" placeholder="tu@email.com"
                  class="px-4 py-2.5 rounded-lg border border-neutral-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="c-telefono" class="text-sm font-medium text-dark">Teléfono / WhatsApp *</label>
                <input id="c-telefono" name="telefono" type="tel" required placeholder="+54 9 261 ..."
                  class="px-4 py-2.5 rounded-lg border border-neutral-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
              </div>
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="c-asunto" class="text-sm font-medium text-dark">Asunto</label>
              <select id="c-asunto" name="asunto"
                class="px-4 py-2.5 rounded-lg border border-neutral-200 text-sm text-dark focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary bg-white">
                <option value="consulta">Consulta general</option>
                <option value="presupuesto">Solicitud de presupuesto</option>
                <option value="distribuidor">Ser distribuidor</option>
                <option value="otro">Otro</option>
              </select>
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="c-mensaje" class="text-sm font-medium text-dark">Mensaje *</label>
              <textarea id="c-mensaje" name="mensaje" rows="5" required placeholder="¿En qué podemos ayudarte?"
                class="px-4 py-2.5 rounded-lg border border-neutral-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary resize-none"></textarea>
            </div>

            <button type="submit"
              class="w-full bg-primary hover:bg-primary-hover text-white font-medium py-3 rounded-lg transition-colors flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12 0C5.373 0 0 5.373 0 12c0 2.124.557 4.117 1.532 5.845L.057 23.49a.5.5 0 0 0 .612.612l5.782-1.447A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.89 0-3.66-.5-5.19-1.374l-.37-.22-3.834.958.977-3.763-.242-.384A9.958 9.958 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
              Enviar consulta
            </button>

            <p class="text-xs text-neutral-400 text-center">
              Tu mensaje se enviará directamente por WhatsApp.
            </p>
          </form>
        </div>

        <!-- Datos -->
        <div class="flex flex-col gap-8">
          <div>
            <h2 class="text-2xl font-bold text-dark mb-6">Datos de contacto</h2>
            <ul class="flex flex-col gap-5" role="list">
              <li class="flex gap-4 items-start">
                <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-[#25D366]/10 text-[#25D366] shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12 0C5.373 0 0 5.373 0 12c0 2.124.557 4.117 1.532 5.845L.057 23.49a.5.5 0 0 0 .612.612l5.782-1.447A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.89 0-3.66-.5-5.19-1.374l-.37-.22-3.834.958.977-3.763-.242-.384A9.958 9.958 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
                </span>
                <div>
                  <p class="text-sm font-semibold text-dark">WhatsApp</p>
                  <a href={CONTACT.whatsapp.principal} target="_blank" rel="noopener noreferrer"
                    class="text-neutral-600 hover:text-primary transition-colors">
                    +54 9 261 667-2585 (principal)
                  </a>
                  <br />
                  <a href={`https://wa.me/${CONTACT.whatsapp.numeroAlt}`} target="_blank" rel="noopener noreferrer"
                    class="text-neutral-600 hover:text-primary transition-colors">
                    +54 9 261 667-2553 (alternativo)
                  </a>
                </div>
              </li>

              <li class="flex gap-4 items-start">
                <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-primary-light text-primary shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="20" height="20" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
                </span>
                <div>
                  <p class="text-sm font-semibold text-dark">Email</p>
                  <a href={`mailto:${CONTACT.email}`} class="text-neutral-600 hover:text-primary transition-colors">
                    {CONTACT.email}
                  </a>
                </div>
              </li>

              <li class="flex gap-4 items-start">
                <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-primary-light text-primary shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="20" height="20" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
                </span>
                <div>
                  <p class="text-sm font-semibold text-dark">Ubicación</p>
                  <p class="text-neutral-600">Mendoza, Argentina</p>
                </div>
              </li>
            </ul>
          </div>

          <!-- Horarios -->
          <div class="bg-white rounded-2xl p-6 border border-neutral-100">
            <h3 class="font-semibold text-dark mb-4">Horario de atención</h3>
            <ul class="flex flex-col gap-2 text-sm" role="list">
              <li class="flex justify-between text-neutral-600">
                <span>Lunes a viernes</span>
                <span class="font-medium text-dark">8:00 — 17:00</span>
              </li>
              <li class="flex justify-between text-neutral-600">
                <span>Sábados</span>
                <span class="font-medium text-dark">8:00 — 13:00</span>
              </li>
              <li class="flex justify-between text-neutral-600">
                <span>Domingos y feriados</span>
                <span class="font-medium text-dark">Cerrado</span>
              </li>
            </ul>
            <p class="mt-4 text-xs text-neutral-400">
              * Los horarios del formulario son a modo de referencia. Podés escribirnos por WhatsApp fuera del horario y te respondemos en la próxima jornada.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('form-contacto') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const nombre = (form.querySelector('#c-nombre') as HTMLInputElement).value.trim();
    const email = (form.querySelector('#c-email') as HTMLInputElement).value.trim();
    const telefono = (form.querySelector('#c-telefono') as HTMLInputElement).value.trim();
    const asunto = (form.querySelector('#c-asunto') as HTMLSelectElement).value;
    const mensaje = (form.querySelector('#c-mensaje') as HTMLTextAreaElement).value.trim();

    if (!nombre || !telefono || !mensaje) return;

    const asuntoLabel: Record<string, string> = {
      consulta: 'Consulta general',
      presupuesto: 'Solicitud de presupuesto',
      distribuidor: 'Ser distribuidor',
      otro: 'Otro',
    };

    const texto = [
      `Hola, me comunico desde el sitio web de Solmed.`,
      `*Nombre:* ${nombre}`,
      email ? `*Email:* ${email}` : null,
      `*Teléfono:* ${telefono}`,
      `*Asunto:* ${asuntoLabel[asunto] ?? asunto}`,
      `*Mensaje:* ${mensaje}`,
    ].filter(Boolean).join('\n');

    window.open(`https://wa.me/5492616672585?text=${encodeURIComponent(texto)}`, '_blank');
  });
</script>
