---
import Layout from '@layouts/Layout.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import Button from '@components/ui/Button.astro';
import { SITE } from '@utils/constants';

const valores = [
  {
    titulo: 'Confianza',
    descripcion: 'Construimos relaciones duraderas con profesionales y pacientes basadas en la transparencia y el cumplimiento.',
    color: 'bg-blue-100 text-blue-700',
  },
  {
    titulo: 'Profesionalismo',
    descripcion: 'Cada producto que comercializamos cumple con los estándares de calidad que el sector médico exige.',
    color: 'bg-primary-light text-primary',
  },
  {
    titulo: 'Innovación',
    descripcion: 'Incorporamos constantemente nuevos insumos y tecnologías para cubrir las necesidades del mercado.',
    color: 'bg-violet-100 text-violet-700',
  },
  {
    titulo: 'Seguridad',
    descripcion: 'La seguridad del paciente es nuestra prioridad. Trabajamos solo con productos certificados.',
    color: 'bg-amber-100 text-amber-700',
  },
];
---

<Layout
  title="Nosotros"
  description="SOLMED SA — 20 años importando y comercializando insumos médicos en Mendoza. Conocé nuestra historia, valores y compromiso con la salud."
>
  <Header />

  <main id="main-content">
    <!-- Hero -->
    <section class="bg-dark py-20 px-4 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-primary font-semibold text-sm uppercase tracking-wider mb-4">Quiénes somos</p>
        <h1 class="text-4xl sm:text-5xl font-bold text-white">
          {SITE.anos} años acompañando a la salud
        </h1>
        <p class="mt-6 text-neutral-300 text-lg leading-relaxed">
          {SITE.fraseInstitucional}
        </p>
      </div>
    </section>

    <!-- Historia -->
    <section class="py-20 px-4 bg-white" aria-labelledby="historia-heading">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 id="historia-heading" class="text-3xl sm:text-4xl font-bold text-dark mb-6">
              Nuestra historia
            </h2>
            <div class="flex flex-col gap-4 text-neutral-600 leading-relaxed">
              <p>
                SOLMED SA nació en Mendoza hace más de 20 años con un objetivo claro:
                garantizar que los insumos médicos lleguen cuando se necesitan, sin demoras
                y con la calidad que los profesionales de la salud merecen.
              </p>
              <p>
                A lo largo de estas dos décadas consolidamos relaciones con los mejores
                proveedores internacionales, construimos un depósito propio y desarrollamos
                una red de distribución que nos permite responder con agilidad a cualquier
                pedido en Mendoza y el resto del país.
              </p>
              <p>
                Hoy somos referencia en insumos médicos y descartables para
                gastroenterología, urología, ORL y otras especialidades, con stock
                permanente y atención personalizada.
              </p>
            </div>
            <div class="mt-8">
              <Button href="/catalogo">Ver nuestro catálogo</Button>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            {[
              { numero: '20+', label: 'Años en el mercado' },
              { numero: '100%', label: 'Stock propio' },
              { numero: 'Mdz', label: 'Con distribución propia' },
              { numero: '4', label: 'Especialidades médicas' },
            ].map(({ numero, label }) => (
              <div class="bg-surface rounded-2xl p-6 text-center border border-neutral-100">
                <p class="text-4xl font-bold text-primary">{numero}</p>
                <p class="text-neutral-600 text-sm mt-2">{label}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Valores -->
    <section class="py-20 px-4 bg-surface" aria-labelledby="valores-heading">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
          <h2 id="valores-heading" class="text-3xl sm:text-4xl font-bold text-dark">
            Nuestros valores
          </h2>
          <p class="mt-4 text-neutral-600 max-w-xl mx-auto">
            Los principios que guían cada decisión que tomamos.
          </p>
        </div>

        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" role="list">
          {valores.map(({ titulo, descripcion, color }) => (
            <li class="bg-white rounded-2xl p-6 border border-neutral-100 shadow-sm flex flex-col gap-3">
              <span class={`self-start text-sm font-bold px-3 py-1 rounded-full ${color}`}>
                {titulo}
              </span>
              <p class="text-neutral-600 text-sm leading-relaxed">{descripcion}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Infraestructura -->
    <section class="py-20 px-4 bg-white" aria-labelledby="infra-heading">
      <div class="max-w-7xl mx-auto text-center">
        <h2 id="infra-heading" class="text-3xl sm:text-4xl font-bold text-dark mb-4">
          Nuestra infraestructura
        </h2>
        <p class="text-neutral-600 max-w-2xl mx-auto mb-12">
          La base que nos permite responder rápido y con certeza.
        </p>
        <ul class="grid grid-cols-1 sm:grid-cols-3 gap-6" role="list">
          {[
            { icon: '🏪', titulo: 'Tienda física', desc: 'Local comercial en Mendoza donde podés ver y retirar los productos.' },
            { icon: '🏭', titulo: 'Depósito propio', desc: 'Stock permanente almacenado en condiciones óptimas.' },
            { icon: '🚚', titulo: 'Distribución propia', desc: 'Entregamos en Mendoza y coordinamos envíos a todo el país.' },
          ].map(({ icon, titulo, desc }) => (
            <li class="bg-surface rounded-2xl p-8 border border-neutral-100 flex flex-col items-center gap-4 text-center">
              <span class="text-4xl" aria-hidden="true">{icon}</span>
              <h3 class="font-semibold text-dark text-lg">{titulo}</h3>
              <p class="text-neutral-600 text-sm leading-relaxed">{desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
